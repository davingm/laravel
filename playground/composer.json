{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "davingm/laravel",
    "type": "project",
    "description": "Laravel starter project by davingm.",
    "keywords": ["laravel", "framework", "blade", "starter"],
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/davingm/laravel",
    "authors": [
        {
            "name": "davingm",
            "homepage": "https://davingm.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../packages/laravel",
            "options": {
                "symlink": true,
                "versions": {
                    "davingm/laravel-runtime": "dev-main"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "davingm/laravel-runtime": "dev-main",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
        "Laravel\\Generators\\": ".laravel/generators/",
            "Database\\Factories\\": "app/database/factories/",
            "Database\\Seeders\\": "app/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('app/database/database.sqlite') || touch('app/database/database.sqlite');\"",
            "node .laravel/cli.js key:generate",
            "node .laravel/cli.js migrate --force",
            "npm ci --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "node .laravel/cli.js dev"
        ],
        "test": [
            "node .laravel/cli.js config:clear --ansi",
            "node .laravel/cli.js test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php -r \"(file_exists('.laravel/cli.js') && file_exists('bootstrap/app.php')) && passthru('node .laravel/cli.js package:discover --ansi');\""
        ],
        "post-update-cmd": [
            "node .laravel/cli.js vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"(file_exists('.laravel/cli.js') && file_exists('bootstrap/app.php')) && passthru('node .laravel/cli.js key:generate --ansi');\"",
            "@php -r \"file_exists('app/database/database.sqlite') || touch('app/database/database.sqlite');\"",
            "@php -r \"(file_exists('.laravel/cli.js') && file_exists('bootstrap/app.php')) && passthru('node .laravel/cli.js migrate --graceful --ansi');\"",
            "npm ci --ignore-scripts",
            "npm run build",
            "@php scripts/install-artisan-cli.php"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "davingm/laravel-runtime": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
