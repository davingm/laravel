{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/assets/ts/**/*.ts", ".laravel/generated/**/*.ts"]
}
