{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "davingm/laravel",
    "type": "project",
    "description": "Early-stage Laravel framework and starter with file-based Blade pages, generators, and frontend tooling.",
    "keywords": [
        "laravel",
        "framework",
        "php",
        "blade",
        "starter-kit",
        "file-based-routing",
        "artisan",
        "crud-generator",
        "vite",
        "server-rendered"
    ],
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/davingm/laravel",
    "authors": [
        {
            "name": "davingm",
            "homepage": "https://davingm.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "davingm/laravel-runtime": "^1.0.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "app/database/factories/",
            "Database\\Seeders\\": "app/database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "bundle": [
            "@php scripts/bundle.php"
        ],
        "post-root-package-install": [
            "@php .materialize-playground.php"
        ],
        "post-create-project-cmd": [
            "@composer dump-autoload --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"(file_exists('.laravel/cli.js') && file_exists('bootstrap/app.php')) && passthru('node .laravel/cli.js key:generate --ansi');\"",
            "@php -r \"file_exists('app/database/database.sqlite') || touch('app/database/database.sqlite');\"",
            "@php -r \"(file_exists('.laravel/cli.js') && file_exists('bootstrap/app.php')) && passthru('node .laravel/cli.js migrate --graceful --ansi');\"",
            "npm ci --ignore-scripts",
            "npm run build"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "davingm/laravel-runtime": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
