{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "davingm/laravel",
    "type": "project",
    "description": "Laravel starter project by davingm.",
    "keywords": [
        "laravel",
        "starter",
        "davingm"
    ],
    "license": "MIT",
    "homepage": "https://github.com/davingm/laravel",
    "authors": [
        {
            "name": "davingm",
            "homepage": "https://github.com/davingm"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "app/database/factories/",
            "Database\\Seeders\\": "app/database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php .materialize-playground.php"
        ],
        "post-create-project-cmd": [
            "@composer dump-autoload --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('app/database/database.sqlite') || touch('app/database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "npm ci --ignore-scripts",
            "npm run build",
            "node .davingm/setup.js"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
