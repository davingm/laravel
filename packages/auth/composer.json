{
    "name": "davingm/auth",
    "description": "Authentication starter for the davingm Laravel framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Davingm\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Davingm\\Auth\\AuthServiceProvider"
            ]
        }
    }
}
