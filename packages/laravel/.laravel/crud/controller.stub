            '{{MODEL_PLURAL}}' => {{MODEL}}::query()->paginate(15),
        ]);
    }

    public function create(): View
    {
        return Frontend::render('{{PAGE_DIRECTORY}}.create', '{{PAGE_DIRECTORY}}.create', [
{{FOREIGN_DATA}}
        ]);
    }

    public function store(Request $request): RedirectResponse
    {
        {{MODEL}}::create($request->validate([
{{VALIDATION_RULES}}
        ]));

        return redirect()->route('{{ROUTE_PREFIX}}.index')->with('success', 'Data berhasil ditambahkan.');
