{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "davingm/laravel-runtime",
    "type": "composer-plugin",
    "description": "Internal Composer plugin that installs the Laravel runtime directory.",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Davingm\\LaravelRuntime\\": "src/"
        }
    },
    "extra": {
        "class": "Davingm\\LaravelRuntime\\RuntimePlugin"
    }
}
