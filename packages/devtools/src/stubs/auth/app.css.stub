@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';
@source '../**/*.blade.php';
@source '../**/*.js';

*, *::before, *::after { box-sizing: border-box; }
html { font-family: Arial, sans-serif; line-height: 1.5; }
body { margin: 0; }
button, input, select, textarea { font: inherit; }

.auth-page { display: grid; min-height: 100vh; place-items: center; padding: 2rem 1rem; background: #111; color: #f5f5f5; font-family: Arial, sans-serif; }
.auth-card { width: min(100%, 27rem); border: 1px solid #303030; border-radius: .8rem; background: #1b1b1b; padding: 2rem; box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 24%); }
.auth-brand { margin-bottom: 1.75rem; text-align: center; }
.auth-brand-icon { width: 2rem; height: 2rem; color: #75b8ff; }
.auth-title { margin: .75rem 0 .35rem; color: #f5f5f5; font-size: 1.35rem; font-weight: 650; }
.auth-subtitle { margin: 0; color: #999; font-size: .85rem; }
.auth-form { display: grid; gap: 1rem; }
.auth-field { display: grid; gap: .4rem; }
.auth-label { color: #ddd; font-size: .78rem; font-weight: 600; }
.auth-input { width: 100%; min-height: 2.8rem; border: 1px solid #3a3a3a; border-radius: .4rem; background: #151515; padding: .65rem .8rem; color: #f5f5f5; font: inherit; }
.auth-input:focus { border-color: #1677ff; outline: 2px solid rgb(22 119 255 / 24%); }
.auth-submit { min-height: 2.8rem; border: 0; border-radius: .4rem; background: #1677ff; color: white; cursor: pointer; font: inherit; font-weight: 650; }
.auth-submit:hover { background: #0866dd; }
.auth-field-error,.auth-error { color: #ff8585; font-size: .78rem; }
.auth-error { margin: 0 0 1rem; border: 1px solid #643b3b; border-radius: .4rem; background: #321f1f; padding: .7rem .8rem; }
.auth-footer { margin: 1.25rem 0 0; color: #aaa; font-size: .82rem; text-align: center; }
.auth-footer a { color: #75b8ff; text-decoration: none; }
.auth-footer a:hover { text-decoration: underline; }

.dashboard-page { height: 100vh; height: 100dvh; overflow: hidden; }
.dashboard-page #page-view { height: 100%; min-height: 0; overflow: hidden; }
.dashboard-shell { --dashboard-header-height: 3.125rem; position: relative; display: flex; width: 100%; height: 100%; flex-direction: column; overflow: hidden; background: #f2f4f9; color: #f5f5f5; font-family: Arial, sans-serif; }
.dashboard-header { position: relative; z-index: 10; display: flex; height: var(--dashboard-header-height); flex: 0 0 var(--dashboard-header-height); align-items: center; gap: 1.8rem; background: #1d1d1d; padding-left: 1.5rem; }
.dashboard-cloud-brand { display: inline-flex; flex: 0 0 10.2rem; align-items: center; gap: .45rem; color: #dedede; font-size: 1.18rem; letter-spacing: -.03em; text-decoration: none; white-space: nowrap; }
.dashboard-cloud-brand svg { width: 2rem; height: 1.65rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2.5; }
.dashboard-top-nav,.dashboard-utility-nav { display: flex; height: 100%; align-items: center; }
.dashboard-top-nav { gap: 1.6rem; }
.dashboard-top-nav a,.dashboard-utility-nav > a:not(.dashboard-icon-link) { color: #f0f0f0; font-size: .75rem; text-decoration: none; white-space: nowrap; }
.dashboard-add-link { margin-left: 1.1rem; color: #c9c9c9 !important; font-size: 1.15rem !important; }
.dashboard-utility-nav { gap: clamp(1rem, 2.25vw, 2.4rem); margin-left: auto; padding-left: 1rem; }
.dashboard-icon-link { position: relative; display: inline-flex; align-items: center; justify-content: center; color: #dedede; }
.dashboard-icon-link svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
.dashboard-notifications span { position: absolute; top: -.8rem; right: -.55rem; display: grid; width: 1.25rem; height: 1.25rem; place-items: center; border-radius: 50%; background: #1677ff; color: #fff; font-size: .65rem; }
.dashboard-profile-menu { position: relative; display: flex; align-items: center; }
.dashboard-avatar { display: grid; width: 1.5rem; height: 1.5rem; place-items: center; overflow: hidden; border: 0; border-radius: 50%; background: #0878ff; padding: .15rem; color: #fff; cursor: pointer; list-style: none; }
.dashboard-avatar::-webkit-details-marker { display: none; }
.dashboard-avatar svg { width: 100%; height: 100%; fill: currentColor; stroke: #fff; stroke-linecap: round; stroke-width: 1.5; }
.dashboard-profile-dropdown { position: absolute; top: calc(100% + .65rem); right: -.5rem; z-index: 5; display: grid; width: 12rem; overflow: hidden; border: 1px solid #383838; background: #252525; box-shadow: 0 .5rem 1.25rem #0005; }
.dashboard-profile-name { overflow: hidden; border-bottom: 1px solid #3a3a3a; padding: .75rem 1rem; color: #aaa; font-size: .75rem; text-overflow: ellipsis; white-space: nowrap; }
.dashboard-profile-dropdown a,.dashboard-profile-dropdown button { display: block; width: 100%; border: 0; background: transparent; padding: .7rem 1rem; color: #f2f2f2; font: inherit; font-size: .8rem; text-align: left; text-decoration: none; cursor: pointer; }
.dashboard-profile-dropdown a:hover,.dashboard-profile-dropdown button:hover { background: #353535; }
.dashboard-profile-dropdown form { border-top: 1px solid #3a3a3a; }
.dashboard-registration { display: flex; height: 100%; align-items: center; background: #0878ff; padding: 0 1rem; color: #fff; font-size: .7rem; white-space: nowrap; }
.dashboard-workspace { display: flex; min-height: 0; flex: 1; overflow: hidden; }
.dashboard-sidebar { position: relative; display: flex; width: 15.125rem; flex: 0 0 15.125rem; flex-direction: column; overflow: hidden; background: #202020; }
.dashboard-nav { display: grid; align-content: start; gap: .2rem; }
.dashboard-nav-link { display: flex; min-height: 2.25rem; align-items: center; gap: .8rem; padding: 0 1rem; color: #e6e6e6; font-size: .85rem; text-decoration: none; }
.dashboard-nav-link svg { width: 1rem; height: 1rem; flex: 0 0 1rem; fill: #777; stroke: #777; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
.dashboard-nav-link.is-active { background: #2475f6; color: #fff; }
.dashboard-nav-link.is-active svg { fill: #fff; stroke: #fff; }
.dashboard-nav-link:hover:not(.is-active) { background: #2a2a2a; }
.dashboard-main { min-width: 0; min-height: 0; flex: 1; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; background: #f2f4f9; color: #202124; }
#profile-main { background-color: #f2f4f9; }
.dashboard-collapse { position: absolute; bottom: .65rem; left: .8rem; display: grid; width: 1.2rem; height: 1.2rem; place-items: center; border: 0; background: transparent; padding: 0; color: #bdbdbd; cursor: pointer; }
.dashboard-collapse svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
.profile-main { background: #f2f4f9; color: #1a1a1a; }
.profile-content { width: min(100%, 72rem); margin: 0 auto; padding: 2rem clamp(1rem, 3vw, 2.5rem); }
.profile-heading { margin: 0 auto 1.25rem; max-width: 68rem; }
.profile-eyebrow { display: none; }
.profile-heading h1 { margin: 0; color: #171717; font-size: 1.4rem; font-weight: 600; }
.profile-heading > p:last-child { margin: .4rem 0 0; color: #737373; font-size: .85rem; }
.profile-alert { max-width: 68rem; margin: 0 auto .75rem; padding: .65rem 0; font-size: .82rem; }
.profile-alert-success { color: #236b36; }
.profile-alert-error { color: #8a2929; }
.profile-alert-error p { margin: 0 0 .25rem; font-weight: 600; }
.profile-alert-error ul { margin: 0; padding-left: 1.1rem; }
.profile-form { width: min(100%, 68rem); margin: 0 auto; border: 1px solid #383838; background: #1f1f1f; padding: 1.5rem 1.75rem; color: #f1f1f1; }
.profile-section { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.5rem; border-bottom: 1px solid #373737; padding: 1rem 0 1.25rem; }
.profile-section h2,.profile-hint { grid-column: 1 / -1; }
.profile-section h2 { margin: 0; color: #f1f1f1; font-size: 1rem; font-weight: 600; }
.profile-hint { margin: -.65rem 0 0; color: #aaa; font-size: .8rem; }
.profile-field { display: grid; gap: .4rem; color: #d5d5d5; font-size: .8rem; }
.profile-field input { width: 100%; min-height: 2.25rem; border: 0; border-bottom: 1px solid #555; border-radius: 0; background: transparent; padding: .4rem 0; color: #f5f5f5; font: inherit; outline: none; }
.profile-field input:focus { border-color: #3980ff; }
.profile-actions { display: flex; justify-content: end; padding: 1rem 0 0; }
.profile-save-button { border: 0; background: #2475f6; padding: .6rem 1rem; color: #fff; font: inherit; font-size: .8rem; cursor: pointer; }
.profile-save-button:hover { background: #1764df; }
@media (max-width: 900px) {
    .dashboard-header { gap: 1rem; padding-left: 1rem; }
    .dashboard-cloud-brand { flex-basis: auto; }
    .dashboard-top-nav { gap: 1rem; }
    .dashboard-utility-nav { gap: 1rem; }
    .dashboard-utility-nav > a[href="#tools"],.dashboard-utility-nav > a[href="#tickets"] { display: none; }
}
@media (max-width: 640px) {
    .dashboard-shell { --dashboard-header-height: 3.25rem; }
    .dashboard-header { gap: .9rem; padding-left: .75rem; }
    .dashboard-cloud-brand { gap: .3rem; font-size: .95rem; }
    .dashboard-cloud-brand svg { width: 1.7rem; }
    .dashboard-top-nav { gap: .75rem; }
    .dashboard-top-nav a { font-size: .68rem; }
    .dashboard-top-nav a:nth-child(2),.dashboard-add-link,.dashboard-utility-nav > a[href="#billing"],.dashboard-registration { display: none; }
    .dashboard-utility-nav { gap: .8rem; padding-left: 0; }
    .dashboard-sidebar { width: 12rem; flex-basis: 12rem; }
    .profile-content { padding: 1.5rem .85rem; }
    .profile-section { grid-template-columns: 1fr; }
    .profile-section h2,.profile-hint { grid-column: auto; }
    .profile-form { padding: 1rem; }
}

/* Shared styling for CRUD screens generated by the framework. */
.crud-shell { width: min(100% - 2rem, 72rem); margin: 0 auto; padding: 3rem 0; }
.narrow-shell { max-width: 44rem; }
.crud-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid #e5e5e5; }
.eyebrow { margin: 0 0 .5rem; color: #737373; font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
.crud-title { margin: 0; color: #111; font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 650; letter-spacing: -.035em; }
.crud-description { margin: .4rem 0 0; color: #666; font-size: .925rem; }
.crud-shell { width: min(100% - 2rem, 80rem); padding: 1.5rem 0; }
.button { display: inline-flex; min-height: 2.25rem; align-items: center; justify-content: center; gap: .4rem; border: 1px solid #d4d8e0; border-radius: .15rem; padding: .45rem .75rem; font-size: .8rem; font-weight: 550; text-decoration: none; cursor: pointer; }
.button-primary { border-color: #2475f6; background: #2475f6; color: #fff; }
.button-primary:hover { border-color: #1768e8; background: #1768e8; }
.button-secondary { border-color: #d4d4d4; background: #fff; color: #222; }
.button-secondary:hover { background: #f5f5f5; }
.button-danger { border-color: #d4d4d4; background: #fff; color: #444; }
.button-danger:hover { border-color: #999; background: #f5f5f5; }
.button-small { min-height: 2rem; padding: .35rem .65rem; font-size: .75rem; }
.crud-summary,.table-wrap,.barang-form { border: 1px solid #e5e5e5; background: #fff; }
.crud-summary { display: flex; align-items: center; gap: .4rem; margin-bottom: 1rem; padding: .75rem 0; border: 0; border-bottom: 1px solid #e5e5e5; color: #737373; font-size: .85rem; }
.crud-summary-count { color: #111; font-size: 1.25rem; font-weight: 650; }
.crud-search-wrap { margin-left: auto; }
.crud-search { width: 100%; max-width: 17rem; border: 1px solid #d4d4d4; border-radius: .3rem; padding: .55rem .7rem; color: #111; font: inherit; font-size: .85rem; outline: none; }
.crud-search:focus,.barang-form input:focus,.barang-form select:focus,.barang-form textarea:focus { border-color: #2475f6; box-shadow: 0 0 0 1px #2475f6; }
.table-wrap { overflow-x: auto; border: 1px solid #e5e7eb; }
.barang-table { width: 100%; border-collapse: collapse; text-align: left; font-size: .875rem; }
.barang-table thead { background: #f5f6f8; color: #666; font-size: .7rem; letter-spacing: .04em; text-transform: uppercase; }
.barang-table th,.barang-table td { padding: .8rem .75rem; white-space: nowrap; }
.barang-table th { font-weight: 600; }
.barang-table tbody tr { border-top: 1px solid #eee; }
.barang-table tbody tr:hover { background: #fafafa; }
.table-actions { display: flex; align-items: center; gap: .4rem; }
.inline-form { display: inline-flex; }
.crud-empty-state { max-width: 22rem; margin: 0 auto; padding: 2rem 0; text-align: center; }
.empty-state-mark { display: none; }
.crud-empty-state h2 { margin: 0; color: #111; font-size: 1rem; font-weight: 600; }
.crud-empty-state p { margin: .4rem 0 1rem; color: #737373; font-size: .875rem; }
.crud-pagination { margin-top: 1rem; }
.crud-form-heading { margin-bottom: 1.5rem; }
.back-link { color: #555; font-size: .85rem; font-weight: 500; text-decoration: none; }
.back-link:hover { color: #111; text-decoration: underline; }
.barang-form { display: block; border-right: 0; border-left: 0; padding: 1.25rem 0; }
.barang-form-grid { display: grid; gap: 1.1rem; }
.barang-form label,.crud-field { display: grid; align-content: start; gap: .45rem; color: #333; font-size: .85rem; font-weight: 550; }
.barang-form input:not([type=hidden]):not([type=checkbox]),.barang-form select,.barang-form textarea,.crud-input { width: 100%; min-height: 2.4rem; border: 1px solid #d4d8e0; border-radius: .15rem; background: #fff; padding: .55rem .65rem; color: #111; font: inherit; font-weight: 400; outline: none; }
.barang-form input[type=checkbox],.crud-checkbox { width: 1rem; height: 1rem; accent-color: #2475f6; }
.crud-checkbox-field { display: flex !important; align-items: center; gap: .6rem !important; }
.form-error { color: #444; font-size: .75rem; font-weight: 500; }
.form-error-summary { margin-bottom: 1.25rem; border: 1px solid #ddd; background: #fafafa; padding: .8rem 1rem; color: #333; font-size: .85rem; }
.crud-form-actions { display: flex; justify-content: end; gap: .6rem; margin-top: 1.5rem; border-top: 1px solid #eee; padding-top: 1rem; }
.empty-state { padding: 2.5rem 1rem; color: #666; text-align: center; }
.actions-heading { text-align: right; }
.flash-success { margin-bottom: 1.25rem; border-left: 2px solid #111; padding: .5rem .75rem; color: #222; font-size: .875rem; }
.flash-error { margin-bottom: 1.25rem; border-left: 2px solid #b42318; padding: .5rem .75rem; color: #8a2929; font-size: .875rem; }
@media (min-width: 640px) { .crud-shell { width: min(100% - 3rem, 72rem); } .barang-form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 640px) { .crud-heading { align-items: start; flex-direction: column; } .crud-form-actions { flex-direction: column-reverse; } .crud-search { max-width: none; } }

/* Compact CRUD pages inside the EdgeOne-style dashboard. */
.dashboard-main .crud-shell { width: 100%; max-width: none; margin: 0; padding: 1.5rem 1.75rem; }
.dashboard-main .narrow-shell { max-width: 48rem; margin: 0 auto; }
.dashboard-main .crud-heading { align-items: center; margin: 0 0 1rem; border: 0; padding: 0; }
.dashboard-main .crud-title { color: #202124; font-size: 1.25rem; font-weight: 600; letter-spacing: 0; }
.dashboard-main .crud-description { margin-top: .3rem; color: #777; font-size: .78rem; }
.dashboard-main .crud-summary { min-height: 2.5rem; margin: 0; border-bottom: 0; color: #70757d; font-size: .75rem; }
.dashboard-main .crud-summary-count { color: #202124; font-size: .85rem; font-weight: 600; }
.dashboard-main .crud-search { max-width: 15rem; border-radius: 0; padding: .45rem .55rem; font-size: .75rem; }
.dashboard-main .table-wrap { border: 1px solid #e5e7eb; background: #fff; }
.dashboard-main .barang-table { font-size: .76rem; }
.dashboard-main .barang-table thead { background: #f6f7f9; color: #555d68; font-size: .68rem; letter-spacing: 0; }
.dashboard-main .barang-table tbody { color: #30343b; }
.dashboard-main .barang-table tbody td { color: #30343b !important; }
.dashboard-main .barang-table th,.dashboard-main .barang-table td { padding: .65rem .7rem; }
.dashboard-main .barang-table tbody tr:hover { background: #f8faff; }
.dashboard-main .actions-cell { width: 1%; white-space: nowrap; text-align: right; }
.dashboard-main .table-actions { display: inline-flex; width: auto; justify-content: flex-end; white-space: nowrap; }
.dashboard-main .button { min-height: 2rem; border-radius: 0; padding: .35rem .65rem; font-size: .74rem; font-weight: 500; }
.dashboard-main .button-primary { border-color: #2475f6; background: #2475f6; }
.dashboard-main .button-primary:hover { border-color: #1768e8; background: #1768e8; }
.dashboard-main .button-secondary { border-color: #d9dde3; background: #fff; color: #3b414a; }
.dashboard-main .button-secondary:hover { border-color: #b8c0cb; background: #f6f7f9; }
.dashboard-main .crud-form-heading { margin-bottom: 1rem; }
.dashboard-main .crud-form-heading .back-link { display: inline-block; margin-bottom: .8rem; color: #667080; font-size: .75rem; }
.dashboard-main .barang-form { margin-top: .75rem; border: 1px solid #e3e6eb; background: #fff; padding: 1.25rem; }
.dashboard-main .barang-form-grid { gap: 1rem; }
.dashboard-main .crud-field { gap: .35rem; color: #434a54; font-size: .75rem; font-weight: 500; }
.dashboard-main .crud-input { min-height: 2.25rem; border-color: #d9dde3; border-radius: 0; padding: .45rem .55rem; font-size: .78rem; }
.dashboard-main .crud-input:focus { border-color: #2475f6; box-shadow: 0 0 0 1px #2475f6; }
.dashboard-main .crud-checkbox-field { display: flex; min-height: 2.25rem; align-items: center; gap: .5rem; padding-top: 1.1rem; }
.dashboard-main .crud-form-actions { margin-top: 1rem; border-color: #eceef1; padding-top: .85rem; }
.dashboard-main .form-error-summary { border-color: #f0d1ce; background: #fff8f7; color: #8a2929; font-size: .75rem; }
.dashboard-main .form-error { color: #b42318; font-size: .7rem; }
.dashboard-main .flash-success,.dashboard-main .flash-error { margin: 0 0 .75rem; padding: .45rem .65rem; font-size: .75rem; }
.dashboard-main .crud-empty-state { padding: 1.5rem 0; }
.dashboard-main .crud-empty-state h2 { font-size: .85rem; }
.dashboard-main .crud-empty-state p { font-size: .75rem; }
.dashboard-main .crud-pagination { margin-top: .75rem; font-size: .75rem; }
.overview-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin: 1.25rem 0; }
.overview-card,.overview-section { border: 1px solid #e5e7eb; background: #fff; }
.overview-card { display: grid; gap: .55rem; padding: 1rem; }
.overview-card span,.transaction-meta span { color: #737b86; font-size: .74rem; }
.overview-card strong { color: #202124; font-size: 1.2rem; font-weight: 600; }
.overview-section { margin-top: 1rem; }
.overview-section-heading,.transaction-items-heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .8rem .75rem; }
.overview-section-heading h2,.transaction-items-heading h2 { margin: 0; color: #30343b; font-size: .85rem; font-weight: 600; }
.overview-actions { display: flex; gap: .5rem; margin: 0 0 .75rem; }
.transaction-items { display: grid; gap: .6rem; }
.transaction-item-row { display: grid; grid-template-columns: minmax(14rem, 2fr) minmax(7rem, 1fr) auto; align-items: start; gap: .7rem; border-bottom: 1px solid #eceef1; padding: .75rem 0; }
.transaction-item-row.transaction-sale-row { grid-template-columns: minmax(14rem, 2fr) minmax(7rem, 1fr) minmax(8rem, 1fr) auto; }
.transaction-item-row > [data-remove-item] { align-self: start; margin-top: 1.35rem; white-space: nowrap; }
.transaction-item-row > .form-error { grid-column: 1 / -1; }
.stock-availability { color: #68717d; font-size: .68rem; font-weight: 400; }
.transaction-notes { margin-top: 1rem; }
.transaction-meta { display: flex; flex-wrap: wrap; gap: 1.5rem; border: 1px solid #e5e7eb; background: #fff; padding: .85rem; }
.transaction-meta div { display: grid; gap: .3rem; }
.transaction-meta strong { color: #30343b; font-size: .8rem; font-weight: 500; }
.transaction-note { margin: 1rem 0; color: #555d68; font-size: .8rem; }
.transaction-cancel { display: flex; justify-content: end; margin-top: 1rem; }
.report-filter-scroll { max-width: 100%; overflow-x: auto; }
.report-filters { display: grid; width: 100%; min-width: 52rem; grid-template-columns: 8rem 8rem 9rem minmax(12rem, 1fr) auto; align-items: end; gap: .65rem; border-bottom: 1px solid #e1e4e9; padding: .25rem 0 .85rem; }
.report-filters .crud-field { min-width: 0; gap: .3rem; color: #626b77; font-size: .7rem; font-weight: 500; }
.report-filters .crud-input { min-width: 0; min-height: 2.15rem; border-color: #d9dde3; background: #fff; padding: .4rem .5rem; font-size: .75rem; }
.report-filter-actions { display: flex; gap: .35rem; white-space: nowrap; }
.report-filter-actions .button { min-height: 2.15rem; padding: .35rem .6rem; font-size: .72rem; }
.report-filter-note,.report-section-note { color: #737b86; font-size: .7rem; }
.report-filter-note { margin: .55rem 0 1rem; }
@media (max-width: 900px) { .overview-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .transaction-item-row,.transaction-item-row.transaction-sale-row { grid-template-columns: 1fr 1fr; } .transaction-item-row > [data-remove-item] { margin-top: 0; } }
@media (max-width: 640px) {
    .dashboard-main .crud-shell { padding: 1.25rem 1rem; }
    .dashboard-main .crud-summary { gap: .5rem; }
    .dashboard-main .crud-search { max-width: 10rem; }
    .dashboard-main .barang-form { padding: .9rem; }
    .overview-grid { grid-template-columns: 1fr 1fr; }
    .overview-actions { flex-wrap: wrap; }
    .transaction-item-row,.transaction-item-row.transaction-sale-row { grid-template-columns: 1fr; }
}

/* Developer workspace dashboard */
.developer-dashboard .dashboard-shell {
    --dashboard-header-height: 4.25rem;
    background: #f7f8fc;
    color: #172033;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
.developer-dashboard .dashboard-header {
    gap: 1.5rem;
    border-bottom: 1px solid #e8ebf2;
    background: #fff;
    padding: 0 1.75rem;
    color: #28334a;
}
.developer-dashboard .dashboard-cloud-brand { flex: 0 0 auto; gap: .6rem; color: #303b52; font-size: .82rem; font-weight: 650; letter-spacing: 0; }
.developer-dashboard .dashboard-cloud-brand img { width: 1.15rem; height: 1.15rem; }
.developer-dashboard .dashboard-top-nav { gap: 1.6rem; }
.developer-dashboard .dashboard-top-nav a { position: relative; display: flex; height: 100%; align-items: center; color: #788196; font-size: .78rem; font-weight: 550; text-decoration: none; }
.developer-dashboard .dashboard-top-nav a:hover,.developer-dashboard .dashboard-top-nav a.is-current { color: #303b52; }
.developer-dashboard .dashboard-top-nav a.is-current::after { position: absolute; right: 0; bottom: -.05rem; left: 0; height: 2px; background: #6758e8; content: ""; }
.developer-dashboard .dashboard-utility-nav { gap: .8rem; }
.developer-dashboard .dashboard-command-search { display: flex; width: clamp(10rem, 17vw, 15rem); height: 2.25rem; align-items: center; gap: .55rem; border: 1px solid #e6e9f0; border-radius: .55rem; background: #fafbfc; padding: 0 .6rem; }
.developer-dashboard .dashboard-command-search img { width: .9rem; height: .9rem; opacity: .55; }
.developer-dashboard .dashboard-command-search input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: #39445b; font: inherit; font-size: .7rem; }
.developer-dashboard .dashboard-command-search input::placeholder { color: #9aa2b2; }
.developer-dashboard .dashboard-command-search kbd { flex: 0 0 auto; border: 1px solid #e5e8ee; border-radius: .25rem; background: #fff; padding: .12rem .25rem; color: #8b93a2; font: inherit; font-size: .63rem; }
.developer-dashboard .dashboard-header-action { position: relative; display: inline-flex; min-height: 2.2rem; align-items: center; justify-content: center; gap: .4rem; border: 1px solid #e6e9f0; border-radius: .5rem; padding: 0 .65rem; color: #58647c; font-size: .72rem; font-weight: 550; text-decoration: none; }
.developer-dashboard .dashboard-header-action img { width: 1rem; height: 1rem; }
.developer-dashboard .dashboard-create-action { border-color: #6758e8; background: #6758e8; padding: 0 .8rem; color: #fff; }
.developer-dashboard .dashboard-create-action img { filter: brightness(0) invert(1); }
.developer-dashboard .dashboard-notification-action { width: 2.25rem; padding: 0; }
.developer-dashboard .notification-dot { position: absolute; top: .42rem; right: .43rem; width: .4rem; height: .4rem; border: 1.5px solid #fff; border-radius: 50%; background: #f16f76; }
.developer-dashboard .dashboard-help-action { width: 2rem; min-height: 2rem; border-color: transparent; border-radius: 50%; background: #f2f3f8; padding: 0; color: #66718a; font-size: .75rem; font-weight: 700; }
.developer-dashboard .dashboard-avatar { display: flex; width: auto; height: 2.2rem; gap: .35rem; border: 0; border-radius: 2rem; background: transparent; padding: .1rem; color: #fff; }
.developer-dashboard .dashboard-avatar > span { display: grid; width: 1.9rem; height: 1.9rem; place-items: center; border-radius: 50%; background: linear-gradient(140deg, #8272f2, #5142c5); font-size: .72rem; font-weight: 700; }
.developer-dashboard .dashboard-avatar img { width: .75rem; height: .75rem; opacity: .6; }
.developer-dashboard .dashboard-profile-dropdown { top: calc(100% + .4rem); border: 1px solid #e6e9f0; border-radius: .65rem; background: #fff; box-shadow: 0 12px 30px #1c27421a; }
.developer-dashboard .dashboard-profile-name { border-color: #edf0f4; color: #6f7990; }
.developer-dashboard .dashboard-profile-dropdown a,.developer-dashboard .dashboard-profile-dropdown button { color: #35415a; }
.developer-dashboard .dashboard-profile-dropdown a:hover,.developer-dashboard .dashboard-profile-dropdown button:hover { background: #f5f6fa; }
.developer-dashboard .dashboard-profile-dropdown form { border-color: #edf0f4; }
.developer-dashboard .dashboard-workspace { min-height: 0; }
.developer-dashboard .dashboard-sidebar { width: 15.5rem; flex-basis: 15.5rem; border-right: 1px solid #262738; background: #171824; padding: 0 .8rem 1rem; overflow-x: hidden; overflow-y: auto; scrollbar-color: #393a4b transparent; scrollbar-width: thin; }
.workspace-copy,.sidebar-help > span:nth-child(2) { display: grid; gap: .12rem; }
.developer-dashboard .workspace-switcher { display: flex; width: 100%; min-height: 3.35rem; align-items: center; gap: .6rem; border: 1px solid #303140; border-radius: .6rem; background: #20212f; padding: .45rem .55rem; color: #f4f4fa; text-align: left; }
.workspace-avatar { display: grid; width: 1.9rem; height: 1.9rem; flex: 0 0 1.9rem; place-items: center; border-radius: .5rem; background: #e8c878; color: #353044; font-size: .65rem; font-weight: 750; }
.workspace-copy { min-width: 0; flex: 1; }
.workspace-copy strong { overflow: hidden; color: #f1f1f7; font-size: .68rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.workspace-copy small { color: #8b8da0; font-size: .58rem; }
.workspace-switcher > img,.sidebar-help > img { width: .85rem; height: .85rem; opacity: .55; }
.developer-dashboard .dashboard-nav { gap: .15rem; padding-top: .65rem; }
.developer-dashboard .dashboard-nav-label { margin: .95rem .6rem .35rem; color: #7d8095; font-size: .56rem; font-weight: 700; letter-spacing: .12em; }
.developer-dashboard .dashboard-nav-link { min-height: 2.1rem; gap: .7rem; border-radius: .45rem; padding: 0 .65rem; color: #a6a8b8; font-size: .72rem; font-weight: 520; }
.developer-dashboard .dashboard-nav-link img { width: 1rem; height: 1rem; flex: 0 0 1rem; opacity: .75; filter: brightness(0) saturate(100%) invert(72%) sepia(9%) saturate(461%) hue-rotate(197deg) brightness(90%); }
.developer-dashboard .dashboard-nav-link.is-active { background: #393455; color: #e5e1ff; }
.developer-dashboard .dashboard-nav-link.is-active img { opacity: 1; filter: brightness(0) saturate(100%) invert(81%) sepia(24%) saturate(1090%) hue-rotate(204deg) brightness(102%); }
.developer-dashboard .dashboard-nav-link:hover:not(.is-active) { background: #252634; color: #f1f0fa; }
.nav-count { margin-left: auto; border-radius: .3rem; background: #2a2b3a; padding: .12rem .35rem; color: #9698aa; font-size: .58rem; }
.nav-count-alert { background: #493039; color: #f0a1a7; }
.developer-dashboard .sidebar-help { display: flex; min-height: 3.4rem; align-items: center; gap: .55rem; margin-top: auto; border: 1px solid #303140; border-radius: .55rem; padding: .45rem .55rem; color: #e9e9f1; }
.sidebar-help-icon { display: grid; width: 1.4rem; height: 1.4rem; place-items: center; border: 1px solid #64657a; border-radius: 50%; color: #c2c1d3; font-size: .7rem; font-weight: 700; }
.sidebar-help > span:nth-child(2) { flex: 1; }
.sidebar-help strong { font-size: .63rem; font-weight: 600; }
.sidebar-help small { color: #8b8da0; font-size: .55rem; }
.developer-dashboard .dashboard-main { background: #f7f8fc; color: #172033; }
.dev-dashboard-content { width: min(100%, 112rem); margin: 0 auto; padding: 2rem clamp(1.25rem, 2.7vw, 2.6rem) 2.5rem; }
.dashboard-welcome { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.45rem; }
.dashboard-eyebrow { display: flex; align-items: center; gap: .4rem; margin: 0 0 .55rem; color: #828ba0; font-size: .6rem; font-weight: 700; letter-spacing: .12em; }
.status-pulse { width: .4rem; height: .4rem; border-radius: 50%; background: #37c98b; box-shadow: 0 0 0 3px #37c98b20; }
.dashboard-welcome h1 { margin: 0; color: #1c2539; font-size: clamp(1.35rem, 2vw, 1.8rem); font-weight: 680; letter-spacing: -.045em; }
.dashboard-welcome h1 span { font-size: .82em; }
.dashboard-welcome > div > p:last-child { margin: .4rem 0 0; color: #8992a4; font-size: .74rem; }
.dashboard-primary-button { display: inline-flex; min-height: 2.4rem; align-items: center; gap: .4rem; border-radius: .5rem; background: #6758e8; padding: 0 .85rem; color: #fff; font-size: .72rem; font-weight: 600; text-decoration: none; box-shadow: 0 3px 7px #6758e82b; }
.dashboard-primary-button img { width: .95rem; height: .95rem; filter: brightness(0) invert(1); }
.developer-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .9rem; margin-bottom: 1rem; }
.developer-metric,.dashboard-panel { min-width: 0; border: 1px solid #eaedf3; border-radius: .7rem; background: #fff; box-shadow: 0 2px 6px #26345406; }
.developer-metric { position: relative; min-height: 8.5rem; overflow: hidden; padding: 1rem 1.05rem .85rem; }
.metric-heading { display: flex; align-items: center; justify-content: space-between; color: #737e93; font-size: .68rem; font-weight: 550; }
.metric-icon { display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border-radius: .5rem; }
.metric-icon img { width: 1rem; height: 1rem; }
.metric-icon-purple { background: #f0edff; }
.metric-icon-purple img { filter: brightness(0) saturate(100%) invert(43%) sepia(38%) saturate(1220%) hue-rotate(211deg) brightness(92%); }
.metric-icon-blue { background: #e9f2ff; }
.metric-icon-blue img { filter: brightness(0) saturate(100%) invert(43%) sepia(82%) saturate(1492%) hue-rotate(196deg) brightness(98%); }
.metric-icon-green { background: #e8f8f0; }
.metric-icon-green img { filter: brightness(0) saturate(100%) invert(56%) sepia(44%) saturate(631%) hue-rotate(100deg) brightness(92%); }
.metric-icon-orange { background: #fff2e7; }
.metric-icon-orange img { filter: brightness(0) saturate(100%) invert(65%) sepia(44%) saturate(1068%) hue-rotate(337deg) brightness(100%); }
.metric-value { display: flex; align-items: center; gap: .55rem; margin-top: .55rem; color: #20293d; font-size: 1.65rem; font-weight: 680; letter-spacing: -.045em; }
.metric-unit { margin-left: -.5rem; font-size: 1.05rem; }
.metric-change { border-radius: .3rem; padding: .16rem .32rem; font-size: .57rem; font-weight: 650; letter-spacing: 0; }
.metric-change.positive { background: #e9f8f0; color: #2b9c68; }
.metric-change.neutral { background: #f1f3f7; color: #80899b; }
.developer-metric > p { margin: .28rem 0 0; color: #9aa2b2; font-size: .59rem; }
.metric-sparkline { position: absolute; right: 1rem; bottom: .7rem; display: flex; width: 36%; height: 1.5rem; align-items: end; gap: .18rem; opacity: .48; }
.metric-sparkline i { flex: 1; border-radius: .15rem .15rem 0 0; background: #8b7df4; }
.metric-sparkline i:nth-child(1) { height: 20%; }.metric-sparkline i:nth-child(2) { height: 35%; }.metric-sparkline i:nth-child(3) { height: 28%; }.metric-sparkline i:nth-child(4) { height: 50%; }.metric-sparkline i:nth-child(5) { height: 38%; }.metric-sparkline i:nth-child(6) { height: 62%; }.metric-sparkline i:nth-child(7) { height: 43%; }.metric-sparkline i:nth-child(8) { height: 70%; }.metric-sparkline i:nth-child(9) { height: 55%; }.metric-sparkline i:nth-child(10) { height: 76%; }.metric-sparkline i:nth-child(11) { height: 63%; }.metric-sparkline i:nth-child(12) { height: 100%; }
.sparkline-blue i { background: #69a6fa; }
.metric-progress { height: .22rem; margin-top: 1rem; overflow: hidden; border-radius: 1rem; background: #eef0f5; }
.metric-progress span { display: block; height: 100%; border-radius: inherit; background: #43c790; }
.uptime-bars { display: flex; height: .55rem; gap: .12rem; margin-top: .8rem; }
.uptime-bars i { flex: 1; border-radius: .1rem; background: #42c890; }
.uptime-bars i:nth-child(8),.uptime-bars i:nth-child(19) { background: #f0c36b; }
.dashboard-content-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(19rem, .9fr); align-items: start; gap: .9rem; }
.dashboard-panel { overflow: hidden; }
.projects-panel { grid-column: 1 / -1; }
.dashboard-panel-heading { display: flex; align-items: center; justify-content: space-between; gap: .8rem; padding: 1rem 1.1rem .85rem; }
.dashboard-panel-heading h2 { margin: 0; color: #263148; font-size: .82rem; font-weight: 650; letter-spacing: -.015em; }
.dashboard-panel-heading p { margin: .25rem 0 0; color: #969eae; font-size: .62rem; }
.panel-link { flex: 0 0 auto; color: #7264df; font-size: .62rem; font-weight: 600; text-decoration: none; }
.panel-link span { margin-left: .1rem; font-size: .85rem; }
.projects-table-wrap { width: 100%; overflow-x: auto; }
.projects-table { width: 100%; min-width: 42rem; border-collapse: collapse; text-align: left; }
.projects-table thead { background: #fafbfc; }
.projects-table th { height: 2.2rem; border-top: 1px solid #f0f1f5; border-bottom: 1px solid #f0f1f5; padding: 0 .7rem; color: #9ba3b2; font-size: .52rem; font-weight: 700; letter-spacing: .08em; }
.projects-table th:first-child,.projects-table td:first-child { padding-left: 1.1rem; }
.projects-table td { height: 3.55rem; border-bottom: 1px solid #f1f2f6; padding: .4rem .7rem; color: #59647a; font-size: .61rem; white-space: nowrap; }
.projects-table tbody tr:last-child td { border-bottom: 0; }
.projects-table td:first-child { display: flex; align-items: center; gap: .55rem; }
.project-avatar { display: grid; width: 1.85rem; height: 1.85rem; flex: 0 0 1.85rem; place-items: center; border-radius: .5rem; font-size: .7rem; font-weight: 700; }
.project-avatar-violet { background: #f0edff; color: #715de0; }.project-avatar-blue { background: #e9f3ff; color: #3881df; }.project-avatar-orange { background: #fff0e7; color: #db814b; }.project-avatar-green { background: #e7f7ee; color: #30986a; }
.project-name { display: grid; gap: .2rem; color: #344057; font-size: .64rem; font-weight: 620; }
.project-name small { color: #a0a8b7; font-size: .55rem; font-weight: 450; }
.project-status { display: inline-flex; align-items: center; gap: .3rem; border-radius: 2rem; padding: .23rem .4rem; font-size: .55rem; font-weight: 580; }
.project-status i,.infra-operational i { width: .34rem; height: .34rem; border-radius: 50%; background: currentColor; }
.status-live { background: #e9f8f1; color: #39a675; }.status-review { background: #fff5e6; color: #c18b36; }.status-paused { background: #f1f2f6; color: #7e8798; }
.project-progress { display: inline-block; width: 4rem; height: .28rem; overflow: hidden; border-radius: 1rem; background: #eef0f5; vertical-align: middle; }
.project-progress span { display: block; height: 100%; border-radius: inherit; background: #786ae8; }
.projects-table td:nth-child(3) small { margin-left: .35rem; color: #8b94a5; font-size: .55rem; }
.avatar-stack { display: flex; align-items: center; padding-left: .2rem; }
.avatar-stack i { display: grid; width: 1.35rem; height: 1.35rem; margin-left: -.22rem; place-items: center; border: 2px solid #fff; border-radius: 50%; background: #e4e6f4; color: #636b84; font-size: .43rem; font-style: normal; font-weight: 650; }
.avatar-stack i:nth-child(2) { background: #fbe4db; color: #a66a50; }.avatar-stack i:nth-child(3) { background: #eceef3; color: #7e8798; }
.project-updated { color: #9099a9 !important; }
.project-table-footer { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #f1f2f6; padding: .55rem 1rem; color: #9ba3b2; font-size: .57rem; }
.project-table-footer div { display: flex; gap: .25rem; }
.project-table-footer button { display: grid; width: 1.35rem; height: 1.35rem; place-items: center; border: 1px solid #e9ebf1; border-radius: .3rem; background: #fff; color: #7d8799; font-size: .7rem; }
.deployment-list { padding: 0 1.1rem; }
.deployment-item { display: flex; align-items: flex-start; gap: .65rem; border-top: 1px solid #f1f2f6; padding: .8rem 0; }
.deployment-icon { display: grid; width: 1.75rem; height: 1.75rem; flex: 0 0 1.75rem; place-items: center; border-radius: .5rem; }
.deployment-icon img { width: .9rem; height: .9rem; }
.deployment-success { background: #e9f8f0; }.deployment-success img { filter: brightness(0) saturate(100%) invert(56%) sepia(44%) saturate(631%) hue-rotate(100deg) brightness(92%); }
.deployment-building { background: #edf3ff; }.deployment-building img { filter: brightness(0) saturate(100%) invert(43%) sepia(82%) saturate(1492%) hue-rotate(196deg) brightness(98%); }
.deployment-copy { min-width: 0; flex: 1; }
.deployment-copy strong { display: block; overflow: hidden; color: #3a455b; font-size: .62rem; font-weight: 620; text-overflow: ellipsis; white-space: nowrap; }
.environment-tag { display: inline-block; margin-left: .25rem; border-radius: .2rem; background: #e8f7ef; padding: .12rem .22rem; color: #37986c; font-size: .43rem; font-weight: 700; vertical-align: 1px; }
.environment-staging { background: #fff4e3; color: #b58130; }.environment-preview { background: #eff0ff; color: #6e63ce; }
.deployment-copy p { overflow: hidden; margin: .25rem 0; color: #7e899e; font-size: .57rem; text-overflow: ellipsis; white-space: nowrap; }
.deployment-copy small { color: #a1a8b5; font-size: .53rem; }
.deployment-commit { color: #7a70ce; }
.deployment-check { flex: 0 0 auto; }
.deployment-check img { width: .9rem; height: .9rem; filter: brightness(0) saturate(100%) invert(56%) sepia(44%) saturate(631%) hue-rotate(100deg) brightness(92%); }
.deployment-running { flex: 0 0 auto; border-radius: 2rem; background: #edf3ff; padding: .2rem .35rem; color: #5385d5; font-size: .5rem; }
.activity-footer-link { display: flex; align-items: center; gap: .4rem; border-top: 1px solid #f1f2f6; padding: .75rem 1.1rem; color: #737e93; font-size: .6rem; text-decoration: none; }
.activity-footer-link img { width: .85rem; height: .85rem; opacity: .6; }
.activity-footer-link span { margin-left: auto; color: #9ba3b2; }
.team-members { padding: 0 1.1rem; }
.team-member { display: flex; min-height: 3.05rem; align-items: center; gap: .55rem; border-top: 1px solid #f2f3f6; }
.team-avatar { display: grid; width: 1.8rem; height: 1.8rem; flex: 0 0 1.8rem; place-items: center; border-radius: 50%; font-size: .52rem; font-weight: 700; }
.team-avatar-indigo { background: #e9e7ff; color: #6558bf; }.team-avatar-coral { background: #ffebe6; color: #bd6e58; }.team-avatar-teal { background: #e4f6f3; color: #39877b; }.team-avatar-gold { background: #fff2dc; color: #a97a2e; }
.team-member-copy { display: grid; flex: 1; gap: .15rem; }
.team-member-copy strong { color: #404b60; font-size: .61rem; font-weight: 600; }
.team-member-copy small { color: #9ba3b2; font-size: .53rem; }
.member-presence { width: .45rem; height: .45rem; border: 1.5px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px #e6e9ef; }
.presence-online { background: #45c88f; }.presence-away { background: #f0bb58; }
.team-invite-link { display: flex; align-items: center; gap: .35rem; margin: .45rem 1.1rem .9rem; color: #7164dd; font-size: .58rem; font-weight: 600; text-decoration: none; }
.team-invite-link img { width: .85rem; height: .85rem; filter: brightness(0) saturate(100%) invert(43%) sepia(38%) saturate(1220%) hue-rotate(211deg) brightness(92%); }
.repository-list { padding: 0 1.1rem .35rem; }
.repository-item { display: flex; min-width: 0; align-items: center; gap: .55rem; border-top: 1px solid #f1f2f6; padding: .72rem 0; }
.provider-icon { display: grid; width: 1.7rem; height: 1.7rem; flex: 0 0 1.7rem; place-items: center; border: 1px solid #eceef3; border-radius: .48rem; background: #fff; }
.provider-icon img { width: .9rem; height: .9rem; }
.gitlab-icon img { filter: brightness(0) saturate(100%) invert(56%) sepia(74%) saturate(1270%) hue-rotate(327deg) brightness(93%); }
.docker-icon img { filter: brightness(0) saturate(100%) invert(43%) sepia(82%) saturate(1492%) hue-rotate(196deg) brightness(98%); }
.repository-copy { display: grid; min-width: 0; flex: 1; gap: .18rem; }
.repository-copy strong { overflow: hidden; color: #48536a; font-size: .59rem; font-weight: 590; text-overflow: ellipsis; white-space: nowrap; }
.repository-copy small { color: #9ba3b2; font-size: .52rem; }
.repo-branch { display: flex; align-items: center; gap: .18rem; color: #868fa1; font-size: .52rem; }
.repo-branch img { width: .68rem; height: .68rem; opacity: .55; }
.infrastructure-panel { padding-bottom: .85rem; }
.infrastructure-status { display: flex; align-items: center; gap: .55rem; margin: 0 1.1rem; border-top: 1px solid #f1f2f6; padding: .7rem 0; }
.infrastructure-status-icon { display: grid; width: 1.7rem; height: 1.7rem; flex: 0 0 1.7rem; place-items: center; border-radius: .45rem; background: #f1efff; }
.infrastructure-status-icon img { width: .9rem; height: .9rem; filter: brightness(0) saturate(100%) invert(43%) sepia(38%) saturate(1220%) hue-rotate(211deg) brightness(92%); }
.infrastructure-status > div { display: grid; flex: 1; gap: .15rem; }
.infrastructure-status strong { color: #4a566c; font-size: .59rem; font-weight: 600; }
.infrastructure-status small { color: #9ba3b2; font-size: .52rem; }
.infra-operational { display: inline-flex; align-items: center; gap: .25rem; border-radius: 2rem; background: #e9f8f0; padding: .2rem .35rem; color: #37996b; font-size: .5rem; }
.infra-operational i { width: .3rem; height: .3rem; }
.server-load { margin: .45rem 1.1rem 0; border-top: 1px solid #f1f2f6; padding-top: .65rem; color: #8791a3; font-size: .55rem; }
.server-load span { display: flex; justify-content: space-between; }
.server-load strong { color: #535f75; font-size: .57rem; }
.server-load > div { height: .25rem; margin-top: .45rem; overflow: hidden; border-radius: 1rem; background: #eef0f5; }
.server-load > div i { display: block; height: 100%; border-radius: inherit; background: #6e62e4; }
.pipeline-success-rate { display: flex; align-items: center; gap: .25rem; border-radius: 2rem; background: #e9f8f0; padding: .25rem .4rem; color: #3a9d71; font-size: .55rem; font-weight: 650; }
.pipeline-success-rate img { width: .75rem; height: .75rem; }
.pipeline-chart { display: flex; height: 5.2rem; align-items: end; gap: .2rem; border-bottom: 1px solid #f0f1f5; margin: 0 1.1rem; padding: .25rem 0 0; }
.pipeline-chart i { flex: 1; border-radius: .18rem .18rem 0 0; background: linear-gradient(180deg, #a69af9, #7163e7); opacity: .82; }
.pipeline-chart i:nth-child(5n) { background: linear-gradient(180deg, #f3a5a8, #e87983); }
.pipeline-legend { display: flex; flex-wrap: wrap; gap: .65rem; padding: .65rem 1.1rem .85rem; color: #9099a9; font-size: .52rem; }
.pipeline-legend span { display: inline-flex; align-items: center; gap: .25rem; }
.pipeline-legend strong { color: #5b667b; font-size: .55rem; font-weight: 620; }
.pipeline-legend i { width: .35rem; height: .35rem; border-radius: 50%; background: #786ae8; }
.pipeline-legend span:nth-child(2) i { background: #e87983; }
.dashboard-content-grid > #activity,.dashboard-content-grid > #analytics,.dashboard-content-grid > #settings,.dashboard-content-grid > #help { position: relative; top: -1rem; }
@media (max-width: 1120px) {
    .developer-dashboard .dashboard-header { gap: 1rem; padding-right: 1rem; padding-left: 1rem; }
    .developer-dashboard .dashboard-top-nav { gap: 1rem; }
    .developer-dashboard .dashboard-sidebar { width: 14rem; flex-basis: 14rem; }
    .dev-dashboard-content { padding-right: 1.25rem; padding-left: 1.25rem; }
}
@media (max-width: 900px) {
    .developer-dashboard .dashboard-top-nav { display: none; }
    .developer-dashboard .dashboard-command-search { width: 11rem; }
    .developer-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dashboard-content-grid { grid-template-columns: minmax(0, 1fr) minmax(17rem, .9fr); }
}
@media (max-width: 700px) {
    .developer-dashboard .dashboard-header { gap: .55rem; padding: 0 .65rem; }
    .developer-dashboard .dashboard-cloud-brand { gap: .4rem; }
    .developer-dashboard .dashboard-cloud-brand span { display: none; }
    .developer-dashboard .dashboard-command-search { width: min(36vw, 11rem); }
    .developer-dashboard .dashboard-command-search kbd,.developer-dashboard .dashboard-help-action { display: none; }
    .developer-dashboard .dashboard-create-action { width: 2.2rem; padding: 0; }
    .developer-dashboard .dashboard-create-action span { display: none; }
    .developer-dashboard .dashboard-utility-nav { gap: .4rem; padding-left: 0; }
    .developer-dashboard .dashboard-sidebar { width: 100%; height: 3.5rem; flex: 0 0 3.5rem; border-right: 0; border-bottom: 1px solid #292a38; padding: 0 .65rem; overflow: hidden; }
    .developer-dashboard .workspace-switcher,.developer-dashboard .sidebar-help { display: none; }
    .developer-dashboard .dashboard-nav { display: flex; height: 100%; align-items: center; gap: .25rem; padding: 0; overflow-x: auto; scrollbar-width: none; }
    .developer-dashboard .dashboard-nav::-webkit-scrollbar { display: none; }
    .developer-dashboard .dashboard-nav-label { display: none; }
    .developer-dashboard .dashboard-nav-link { min-height: 2.05rem; flex: 0 0 auto; gap: .4rem; padding: 0 .55rem; font-size: .65rem; white-space: nowrap; }
    .developer-dashboard .dashboard-nav-link img { width: .85rem; height: .85rem; flex-basis: .85rem; }
    .developer-dashboard .nav-count { display: none; }
    .dev-dashboard-content { padding: 1.2rem .9rem 2rem; }
    .dashboard-content-grid { grid-template-columns: minmax(0, 1fr); }
    .projects-panel { grid-column: auto; }
}
@media (max-width: 460px) {
    .developer-dashboard .dashboard-shell { --dashboard-header-height: 3.65rem; }
    .developer-dashboard .dashboard-utility-nav { gap: .25rem; }
    .developer-dashboard .dashboard-command-search { width: 8.8rem; height: 2rem; }
    .developer-dashboard .dashboard-command-search input { font-size: .63rem; }
    .developer-dashboard .dashboard-header-action { min-height: 2rem; }
    .developer-dashboard .dashboard-notification-action { width: 2rem; }
    .developer-dashboard .dashboard-avatar { height: 2rem; }
    .developer-dashboard .dashboard-avatar > span { width: 1.7rem; height: 1.7rem; }
    .dashboard-welcome { align-items: flex-start; }
    .dashboard-welcome h1 { max-width: 16rem; font-size: 1.2rem; }
    .dashboard-welcome > div > p:last-child { max-width: 16rem; line-height: 1.5; }
    .dashboard-primary-button { min-height: 2.1rem; flex: 0 0 auto; padding: 0 .55rem; font-size: .62rem; }
    .dashboard-primary-button img { width: .8rem; height: .8rem; }
    .developer-metrics { gap: .55rem; }
    .developer-metric { min-height: 8.2rem; padding: .75rem; }
    .metric-heading { font-size: .6rem; }
    .metric-value { gap: .3rem; font-size: 1.4rem; }
    .metric-change { padding: .13rem .22rem; font-size: .5rem; }
    .metric-icon { width: 1.55rem; height: 1.55rem; }
    .metric-icon img { width: .85rem; height: .85rem; }
    .dashboard-panel-heading { padding-right: .8rem; padding-left: .8rem; }
    .projects-table { min-width: 39rem; }
}

/* Restrained Tencent Cloud palette for the developer dashboard. */
.developer-dashboard .dashboard-shell { background: #f2f4f8; color: #202124; font-family: Arial, sans-serif; }
.developer-dashboard .dashboard-header { gap: 1.5rem; border-bottom: 1px solid #333; background: #1d1d1d; padding: 0 1.5rem; }
.developer-dashboard .dashboard-cloud-brand { color: #f0f0f0; font-size: .82rem; }
.developer-dashboard .dashboard-cloud-brand img { filter: brightness(0) invert(1); }
.developer-dashboard .dashboard-top-nav a { color: #bdbdbd; }
.developer-dashboard .dashboard-top-nav a:hover,.developer-dashboard .dashboard-top-nav a.is-current { color: #fff; }
.developer-dashboard .dashboard-top-nav a.is-current::after { background: #1677ff; }
.developer-dashboard .dashboard-command-search { height: 2rem; border: 1px solid #444; border-radius: 2px; background: #262626; }
.developer-dashboard .dashboard-command-search img { filter: brightness(0) invert(1); opacity: .65; }
.developer-dashboard .dashboard-command-search input { color: #eee; }
.developer-dashboard .dashboard-command-search input::placeholder { color: #999; }
.developer-dashboard .dashboard-command-search kbd { border-color: #444; border-radius: 2px; background: #303030; color: #aaa; }
.developer-dashboard .dashboard-header-action { min-height: 2rem; border-color: #484848; border-radius: 2px; color: #ddd; }
.developer-dashboard .dashboard-header-action img { filter: brightness(0) invert(1); opacity: .8; }
.developer-dashboard .dashboard-create-action { border-color: #1677ff; background: #1677ff; }
.developer-dashboard .dashboard-notification-action { width: 2rem; }
.developer-dashboard .notification-dot { width: .32rem; height: .32rem; border: 0; background: #f39826; }
.developer-dashboard .dashboard-help-action { background: #303030; color: #ddd; }
.developer-dashboard .dashboard-avatar > span { border-radius: 2px; background: #1677ff; }
.developer-dashboard .dashboard-avatar img { filter: brightness(0) invert(1); }
.developer-dashboard .dashboard-profile-dropdown { border-color: #444; border-radius: 2px; background: #252525; }
.developer-dashboard .dashboard-profile-name { border-color: #414141; color: #aaa; }
.developer-dashboard .dashboard-profile-dropdown a,.developer-dashboard .dashboard-profile-dropdown button { color: #eee; }
.developer-dashboard .dashboard-profile-dropdown a:hover,.developer-dashboard .dashboard-profile-dropdown button:hover { background: #343434; }
.developer-dashboard .dashboard-profile-dropdown form { border-color: #414141; }
.developer-dashboard .dashboard-sidebar { width: 15.125rem; flex-basis: 15.125rem; border-right: 1px solid #363636; border-radius: 0; background: #202020; padding: 0 .45rem .8rem; }
.developer-dashboard .workspace-switcher { min-height: 2.8rem; border: 1px solid #3a3a3a; border-radius: 2px; background: #292929; padding: .35rem .45rem; }
.workspace-avatar { width: 1.65rem; height: 1.65rem; flex-basis: 1.65rem; border-radius: 2px; background: #1677ff; color: #fff; }
.workspace-copy strong { color: #eee; }
.workspace-copy small { color: #999; }
.developer-dashboard .dashboard-nav { gap: .1rem; padding-top: .35rem; }
.developer-dashboard .dashboard-nav-label { margin: .75rem .6rem .25rem; color: #929292; }
.developer-dashboard .dashboard-nav-link { min-height: 2rem; border-radius: 2px; color: #c9c9c9; }
.developer-dashboard .dashboard-nav-link.is-active { background: #1677ff; color: #fff; }
.developer-dashboard .dashboard-nav-link.is-active img { filter: brightness(0) invert(1); }
.developer-dashboard .dashboard-nav-link:hover:not(.is-active) { background: #303030; color: #fff; }
.nav-count { border-radius: 2px; background: #353535; color: #c0c0c0; }
.nav-count-alert { background: #45351f; color: #f39826; }
.developer-dashboard .sidebar-help { min-height: 2.8rem; border: 1px solid #3a3a3a; border-radius: 2px; color: #eee; }
.sidebar-help-icon { border-color: #686868; color: #ccc; }
.sidebar-help small { color: #999; }
.developer-dashboard .dashboard-main { background: #202020; color: #ededed; }
.dev-dashboard-content { width: min(100%, 112rem); padding: 1.65rem clamp(1.25rem, 2.6vw, 2.4rem) 2.5rem; }
.dashboard-welcome { margin-bottom: 1.1rem; }
.dashboard-eyebrow { margin-bottom: .45rem; color: #777; }
.dashboard-welcome h1 { color: #f2f2f2; font-size: clamp(1.3rem, 2vw, 1.65rem); font-weight: 600; letter-spacing: -.025em; }
.dashboard-welcome > div > p:last-child { color: #777; }
.dashboard-primary-button { min-height: 2.2rem; border-radius: 2px; background: #1677ff; box-shadow: none; }
.developer-dashboard .dashboard-content-grid { grid-template-columns: minmax(0, 1.2fr) minmax(19rem, .8fr); gap: .75rem; }
.developer-dashboard .dashboard-panel { border: 1px solid #3b3b3b; border-radius: 2px; background: #252525; box-shadow: none; }
.developer-dashboard .dashboard-panel-heading { padding: .8rem .9rem; }
.developer-dashboard .dashboard-panel-heading h2 { color: #ededed; font-size: .75rem; font-weight: 650; letter-spacing: .025em; }
.developer-dashboard .dashboard-panel-heading p { color: #777; }
.panel-link,.deployment-commit { color: #1677ff; }
.pipeline-panel,.repositories-panel { min-height: 10.25rem; }
.pipeline-success-rate { border-radius: 2px; background: #f0f5ff; color: #1677ff; }
.pipeline-success-rate img { filter: brightness(0) saturate(100%) invert(38%) sepia(97%) saturate(2181%) hue-rotate(202deg) brightness(102%); }
.pipeline-chart { height: 3.4rem; border-bottom-color: #3b3b3b; }
.pipeline-chart i,.pipeline-chart i:nth-child(5n) { border-radius: 0; background: #1677ff; opacity: .78; }
.pipeline-chart i:nth-child(5) { background: #f39826; opacity: .85; }
.pipeline-legend { justify-content: space-between; padding: .5rem 1.1rem; color: #aaa; }
.repository-list { padding: 0 .9rem .25rem; }
.repository-item { gap: .5rem; border-top-color: #3a3a3a; padding: .53rem 0; }
.provider-icon { width: 1.4rem; height: 1.4rem; flex-basis: 1.4rem; border: 0; border-radius: 0; background: transparent; }
.provider-icon img { width: .85rem; height: .85rem; }
.repository-copy strong { color: #e8e8e8; }
.repository-copy small,.repo-branch { color: #a0a0a0; }
.repo-branch img { filter: brightness(0) saturate(100%) invert(42%) sepia(94%) saturate(2375%) hue-rotate(201deg) brightness(104%); opacity: 1; }
.developer-metrics { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; border: 1px solid #3b3b3b; border-radius: 2px; background: #252525; }
.developer-metric { display: grid; min-height: 5.2rem; align-content: center; gap: .45rem; border: 0; border-right: 1px solid #3b3b3b; border-radius: 0; background: transparent; padding: .7rem 1rem; box-shadow: none; }
.developer-metric:last-child { border-right: 0; }
.metric-heading { color: #aaa; font-size: .65rem; }
.developer-metric > span { color: #aaa; font-size: .65rem; }
.metric-value,.developer-metric > strong { display: flex; align-items: baseline; gap: .35rem; margin: 0; color: #f0f0f0; font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; }
.developer-metric > strong small { color: #1677ff; font-size: .58rem; font-weight: 500; letter-spacing: 0; }
.metric-change.positive { background: transparent; color: #1677ff; }
.metric-progress,.project-progress,.server-load > div { border-radius: 0; background: #e6e6e6; }
.metric-progress span,.project-progress span,.server-load > div i { border-radius: 0; background: #1677ff; }
.uptime-bars { gap: 2px; }
.uptime-bars i,.uptime-bars i:nth-child(8),.uptime-bars i:nth-child(19) { border-radius: 0; background: #1677ff; }
.projects-panel { grid-column: 1 / -1; }
.projects-table { min-width: 38rem; }
.projects-table thead { background: #303030; }
.projects-table th { border-color: #3b3b3b; color: #aaa; }
.projects-table td { border-color: #3b3b3b; color: #d0d0d0; }
.project-avatar,.project-avatar-violet,.project-avatar-blue,.project-avatar-orange,.project-avatar-green { width: 1.65rem; height: 1.65rem; flex-basis: 1.65rem; border: 1px solid #4a4a4a; border-radius: 2px; background: #303030; color: #ddd; }
.project-name { color: #eee; }
.project-name small,.project-updated { color: #aaa !important; }
.project-status { border-radius: 2px; background: #f1f5fb; color: #1677ff; }
.project-status i { background: #1677ff; }
.status-review { background: #fff5e8; color: #a7660b; }
.status-review i { background: #f39826; }
.status-paused { background: #363636; color: #aaa; }
.status-paused i { background: #999; }
.avatar-stack i,.avatar-stack i:nth-child(2),.avatar-stack i:nth-child(3) { border-color: #252525; border-radius: 50%; background: #454545; color: #eee; }
.project-table-footer { border-top-color: #3b3b3b; color: #aaa; }
.project-table-footer button { border-color: #4a4a4a; border-radius: 2px; background: #303030; color: #ccc; }
.deployment-list { padding: 0 .9rem; }
.deployment-item,.team-member { border-color: #3b3b3b; }
.deployment-icon,.deployment-success,.deployment-building { width: 1.4rem; height: 1.4rem; flex-basis: 1.4rem; border-radius: 2px; background: #f0f5ff; }
.deployment-icon img,.deployment-success img,.deployment-building img { width: .8rem; height: .8rem; filter: brightness(0) saturate(100%) invert(38%) sepia(97%) saturate(2181%) hue-rotate(202deg) brightness(102%); }
.deployment-copy strong,.team-member-copy strong { color: #e6e6e6; }
.environment-tag,.environment-staging,.environment-preview { border-radius: 2px; background: #f0f5ff; color: #1677ff; }
.deployment-running { border-radius: 2px; background: #fff5e8; color: #a7660b; }
.deployment-check img { filter: brightness(0) saturate(100%) invert(38%) sepia(97%) saturate(2181%) hue-rotate(202deg) brightness(102%); }
.activity-footer-link { border-color: #e8e8e8; color: #1677ff; }
.team-members { padding: 0 .9rem; }
.team-avatar,.team-avatar-indigo,.team-avatar-coral,.team-avatar-teal,.team-avatar-gold { width: 1.6rem; height: 1.6rem; flex-basis: 1.6rem; border: 1px solid #4a4a4a; border-radius: 50%; background: #363636; color: #eee; }
.team-invite-link { color: #1677ff; }
.team-invite-link img { filter: brightness(0) saturate(100%) invert(38%) sepia(97%) saturate(2181%) hue-rotate(202deg) brightness(102%); }
.member-presence,.presence-online,.presence-away { border-color: #fff; background: #1677ff; box-shadow: 0 0 0 1px #1677ff; }
.presence-away { background: #f39826; box-shadow: 0 0 0 1px #f39826; }
.infrastructure-panel { padding-bottom: .75rem; }
.infrastructure-status { border-color: #3b3b3b; }
.infrastructure-status-icon { width: 1.4rem; height: 1.4rem; flex-basis: 1.4rem; border-radius: 2px; background: #f0f5ff; }
.infrastructure-status-icon img { width: .8rem; height: .8rem; filter: brightness(0) saturate(100%) invert(38%) sepia(97%) saturate(2181%) hue-rotate(202deg) brightness(102%); }
.infrastructure-status strong,.server-load strong { color: #e6e6e6; }
.infra-operational { border-radius: 2px; background: #f0f5ff; color: #1677ff; }
.infra-operational i { background: #1677ff; }
.server-load { border-color: #3b3b3b; color: #aaa; }
.server-load > div { background: #e6e6e6; }
.server-load > div i { background: #1677ff; }
.dashboard-content-grid > #activity,.dashboard-content-grid > #analytics,.dashboard-content-grid > #settings,.dashboard-content-grid > #help { top: auto; }
@media (max-width: 900px) {
    .developer-dashboard .dashboard-content-grid { grid-template-columns: minmax(0, 1fr) minmax(16rem, .9fr); }
}
@media (max-width: 700px) {
    .developer-dashboard .dashboard-sidebar { width: 100%; height: 3.5rem; flex-basis: 3.5rem; border-right: 0; border-bottom: 1px solid #363636; padding: 0 .5rem; }
    .developer-dashboard .dashboard-nav { display: flex; }
    .developer-dashboard .dashboard-content-grid { grid-template-columns: minmax(0, 1fr); }
    .projects-panel,.developer-metrics { grid-column: auto; }
}
@media (max-width: 460px) {
    .developer-dashboard .dashboard-header { padding: 0 .65rem; }
    .dev-dashboard-content { padding: 1.1rem .75rem 2rem; }
    .dashboard-welcome { align-items: flex-start; }
    .dashboard-welcome h1 { font-size: 1.2rem; }
    .developer-dashboard .dashboard-primary-button { padding: 0 .55rem; }
    .developer-dashboard .developer-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .developer-dashboard .developer-metric:nth-child(2) { border-right: 0; }
    .developer-dashboard .developer-metric:nth-child(-n+2) { border-bottom: 1px solid #3b3b3b; }
}
@media (min-width: 701px) {
    .developer-dashboard .dashboard-shell { --dashboard-header-height: 3.25rem; }
    .developer-dashboard .dashboard-header {
        gap: 1.75rem;
        border: 0;
        background: #1d1d1d;
        padding: 0 0 0 1.5rem;
    }
    .developer-dashboard .dashboard-cloud-brand {
        flex: 0 0 13.25rem;
        gap: .35rem;
        color: #e8e8e8;
        font-size: 1.12rem;
        font-weight: 400;
        letter-spacing: -.035em;
    }
    .developer-dashboard .dashboard-cloud-brand img {
        width: 2.35rem;
        height: 1.85rem;
        filter: brightness(0) invert(1);
    }
    .developer-dashboard .dashboard-top-nav { gap: 1.9rem; }
    .developer-dashboard .dashboard-top-nav a {
        color: #e7e7e7;
        font-size: .75rem;
        font-weight: 400;
    }
    .developer-dashboard .dashboard-top-nav a.is-current::after { display: none; }
    .developer-dashboard .dashboard-top-nav a:hover { color: #fff; }
    .developer-dashboard .dashboard-add-link { display: inline-flex; width: 1rem; align-items: center; justify-content: center; }
    .developer-dashboard .dashboard-add-link img { width: .9rem; height: .9rem; filter: brightness(0) invert(1); opacity: .8; }
    .developer-dashboard .dashboard-utility-nav { gap: clamp(1.2rem, 2.3vw, 2.35rem); padding-left: 1rem; }
    .developer-dashboard .dashboard-header-icon { display: inline-flex; align-items: center; justify-content: center; color: #dedede; }
    .developer-dashboard .dashboard-header-icon img { width: 1.1rem; height: 1.1rem; filter: brightness(0) invert(1); opacity: .82; }
    .developer-dashboard .dashboard-utility-link { color: #f0f0f0; font-size: .75rem; text-decoration: none; white-space: nowrap; }
    .developer-dashboard .dashboard-utility-link:hover { color: #fff; }
    .developer-dashboard .dashboard-profile-menu { margin-left: -.3rem; }
    .developer-dashboard .dashboard-avatar { width: 1.9rem; height: 1.9rem; justify-content: center; padding: 0; }
    .developer-dashboard .dashboard-avatar img { width: 1.85rem; height: 1.85rem; border-radius: 50%; background: #0878ff; filter: brightness(0) invert(1); }
    .developer-dashboard .dashboard-registration {
        display: flex;
        height: 100%;
        align-items: center;
        justify-content: center;
        margin-left: .1rem;
        background: #0878ff;
        padding: 0 1.15rem;
        color: #fff;
        font-size: .72rem;
        text-decoration: none;
        white-space: nowrap;
    }
    .developer-dashboard .dashboard-sidebar {
        border-right: 0;
        background: #1d1d1d;
    }
}
@media (max-width: 700px) {
    .developer-dashboard .dashboard-header {
        border: 0;
        background: #1d1d1d;
    }
    .developer-dashboard .dashboard-cloud-brand {
        flex: 0 0 auto;
        gap: .35rem;
        color: #e8e8e8;
        font-size: .88rem;
        font-weight: 500;
    }
    .developer-dashboard .dashboard-cloud-brand img { width: 1.85rem; height: 1.5rem; }
    .developer-dashboard .dashboard-top-nav { display: none; }
    .developer-dashboard .dashboard-utility-nav { gap: .7rem; }
    .developer-dashboard .dashboard-header-icon { display: inline-flex; }
    .developer-dashboard .dashboard-header-icon img { width: 1rem; height: 1rem; filter: brightness(0) invert(1); }
    .developer-dashboard .dashboard-utility-link,.developer-dashboard .dashboard-registration { display: none; }
    .developer-dashboard .dashboard-sidebar { border: 0; background: #1d1d1d; }
}
@media (max-width: 460px) {
    .developer-dashboard .dashboard-shell { --dashboard-header-height: 3.25rem; }
    .developer-dashboard .dashboard-header { gap: .4rem; }
    .developer-dashboard .dashboard-cloud-brand { font-size: .78rem; }
    .developer-dashboard .dashboard-cloud-brand img { width: 1.6rem; height: 1.35rem; }
}
@media (min-width: 701px) {
    .developer-dashboard .dashboard-shell {
        --dashboard-header-height: 3.05rem;
        border-radius: 9px;
        background: #1d1d1d;
    }
    .developer-dashboard .dashboard-page,
    .developer-dashboard #page-view { background: #151515; }
    .developer-dashboard .dashboard-header {
        gap: 1.15rem;
        padding-left: 1.1rem;
    }
    .developer-dashboard .dashboard-cloud-brand {
        flex-basis: 13rem;
        gap: .25rem;
        font-size: 1.16rem;
    }
    .developer-dashboard .dashboard-cloud-brand img {
        width: 2.8rem;
        height: 2rem;
    }
    .developer-dashboard .dashboard-top-nav { gap: 1.45rem; }
    .developer-dashboard .dashboard-utility-nav {
        gap: clamp(.85rem, 1.35vw, 1.4rem);
        padding-left: .5rem;
    }
    .developer-dashboard .dashboard-registration { padding: 0 .9rem; }
    .developer-dashboard .dashboard-workspace { background: #1d1d1d; }
    .developer-dashboard .dashboard-sidebar {
        width: 15.125rem;
        flex-basis: 15.125rem;
        border: 0;
        border-radius: 0;
        background: #1d1d1d;
    }
    .developer-dashboard .dashboard-main {
        border-top-left-radius: 13px;
        background-clip: padding-box;
    }
}
@media (max-width: 700px) {
    .developer-dashboard .dashboard-header { gap: .4rem; }
    .developer-dashboard .dashboard-cloud-brand { font-size: .9rem; }
    .developer-dashboard .dashboard-cloud-brand img { width: 2.15rem; height: 1.65rem; }
    .developer-dashboard .dashboard-sidebar { background: #1d1d1d; }
    .developer-dashboard .dashboard-main { border-top-left-radius: 10px; }
}
@media (max-width: 460px) {
    .developer-dashboard .dashboard-shell { --dashboard-header-height: 3.05rem; }
    .developer-dashboard .dashboard-cloud-brand { font-size: .8rem; }
    .developer-dashboard .dashboard-cloud-brand img { width: 1.9rem; height: 1.5rem; }
}
.developer-dashboard .workspace-switcher { margin-top: .65rem; }
.developer-dashboard .dashboard-content-grid {
    align-items: stretch;
    grid-template-areas:
        "pipeline repositories"
        "activity team"
        "metrics metrics"
        "projects projects"
        "deployments infrastructure";
}
.developer-dashboard .dashboard-content-grid > .dashboard-panel { display: flex; min-height: 100%; flex-direction: column; }
.developer-dashboard .pipeline-panel { grid-area: pipeline; }
.developer-dashboard .repositories-panel { grid-area: repositories; }
.developer-dashboard .activity-heatmap-panel { grid-area: activity; }
.developer-dashboard .team-panel { grid-area: team; }
.developer-dashboard .developer-metrics { grid-area: metrics; }
.developer-dashboard .projects-panel { grid-area: projects; }
.developer-dashboard .activity-panel { grid-area: deployments; }
.developer-dashboard .infrastructure-panel { grid-area: infrastructure; }
.activity-heatmap-panel { padding-bottom: .7rem; }
.developer-dashboard .pipeline-chart { flex: 1; min-height: 3.4rem; }
.developer-dashboard .pipeline-legend { margin-top: auto; }
.developer-dashboard .repository-list { display: flex; flex: 1; flex-direction: column; justify-content: space-around; }
.developer-dashboard .team-members { display: flex; flex: 1; flex-direction: column; justify-content: space-around; }
.developer-dashboard .activity-chart-scroll { display: flex; flex: 1; flex-direction: column; justify-content: center; }
.developer-dashboard .activity-legend { margin-top: auto; }
.activity-total { color: #e5e5e5; font-size: .85rem; font-weight: 600; white-space: nowrap; }
.activity-total span { color: #929292; font-size: .62rem; font-weight: 400; }
.activity-chart-scroll { overflow-x: auto; padding: .25rem .9rem 0; scrollbar-color: #484848 transparent; scrollbar-width: thin; }
.activity-months,.activity-grid { min-width: 570px; }
.activity-months { display: grid; grid-template-columns: repeat(52, minmax(0, 1fr)); gap: 3px; margin-bottom: .35rem; color: #969696; font-size: .56rem; }
.activity-months span { min-height: .8rem; white-space: nowrap; }
.activity-chart-body { display: flex; gap: .45rem; }
.activity-weekdays { display: grid; width: 1.65rem; flex: 0 0 1.65rem; grid-template-rows: repeat(7, 1fr); align-items: center; color: #969696; font-size: .52rem; }
.activity-grid { display: grid; grid-auto-flow: column; grid-template-columns: repeat(52, minmax(0, 1fr)); grid-template-rows: repeat(7, minmax(0, 1fr)); gap: 3px; }
.activity-cell,.activity-legend-scale i { display: block; aspect-ratio: 1; border-radius: 2px; background: #343434; }
.activity-level-0 { background: #343434; }
.activity-level-1 { background: #123b70; }
.activity-level-2 { background: #1554a0; }
.activity-level-3 { background: #1677ff; }
.activity-level-4 { background: #75b8ff; }
.activity-legend { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .65rem .9rem 0; color: #929292; font-size: .56rem; }
.activity-legend-scale { display: inline-flex; align-items: center; gap: .2rem; white-space: nowrap; }
.activity-legend-scale i { width: .62rem; }
@media (max-width: 700px) {
    .developer-dashboard .dashboard-content-grid {
        grid-template-areas:
            "pipeline"
            "activity"
            "repositories"
            "team"
            "metrics"
            "projects"
            "deployments"
            "infrastructure";
    }
}
