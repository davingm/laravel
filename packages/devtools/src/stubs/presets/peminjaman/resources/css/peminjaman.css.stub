/* Small native additions for borrowing status labels. The dashboard shell and CRUD styles come from auth:install. */
.status-badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid #d9dde3;
    background: #f6f7f9;
    padding: .25rem .45rem;
    color: #4f5661;
    font-size: .68rem;
    white-space: nowrap;
}

.status-disetujui,
.status-dikembalikan {
    border-color: #c8e5cf;
    background: #f1fbf3;
    color: #236b36;
}

.status-ditolak {
    border-color: #f0d1ce;
    background: #fff8f7;
    color: #8a2929;
}

.status-menunggu,
.status-menunggu_pengembalian {
    border-color: #f1dfb6;
    background: #fffaf0;
    color: #805b10;
}

.table-muted {
    color: #737b86;
    font-size: .72rem;
}
